/* ---------------- password recovery (hash-fragment flow) ---------------- */
function parseHash(){
  const raw=(window.location.hash||'').replace(/^#/,'');
  if(!raw) return {};
  const o={}; new URLSearchParams(raw).forEach((v,k)=>o[k]=v); return o;
}
function showRecover(tokens){
  document.getElementById('login').style.display='none';
  document.getElementById('app').style.display='none';
  const el=document.getElementById('recover'); el.style.display='flex';
  const lg=document.getElementById('recoverLogo'); if(lg) lg.innerHTML=PLAZA_LOGO_SVG;
  fetch(SB_URL+'/auth/v1/user',{headers:{'apikey':SB_KEY,'Authorization':'Bearer '+tokens.access_token}})
    .then(r=>r.json()).then(u=>{
      const w=document.getElementById('rcvwho');
      if(u&&u.email) w.textContent=u.email;
    }).catch(()=>{});
  document.getElementById('npbtn').onclick=async()=>{
    const a=document.getElementById('np1').value, b=document.getElementById('np2').value;
    const err=document.getElementById('nperr');
    if(a.length<8){err.innerHTML='<span class="err">Password must be at least 8 characters.</span>';return;}
    if(a!==b){err.innerHTML='<span class="err">Passwords do not match.</span>';return;}
    err.textContent='Updating...';
    try{
      const r=await fetch(SB_URL+'/auth/v1/user',{method:'PUT',
        headers:{'apikey':SB_KEY,'Authorization':'Bearer '+tokens.access_token,'Content-Type':'application/json'},
        body:JSON.stringify({password:a})});
      const d=await r.json();
      if(!r.ok) throw new Error(d.msg||d.message||d.error_description||'Update failed');
      err.innerHTML='<span class="ok">Password updated &check;</span>';
      SESSION={access_token:tokens.access_token,refresh_token:tokens.refresh_token,
               expires_at:Date.now()+(Number(tokens.expires_in)||3600)*1000};
      localStorage.setItem(LS,JSON.stringify(SESSION));
      history.replaceState(null,'',window.location.pathname);
      setTimeout(()=>{document.getElementById('recover').style.display='none';boot();},700);
    }catch(e){err.innerHTML='<span class="err">'+esc(e.message)+'</span>';}
  };
  document.getElementById('np2').addEventListener('keydown',e=>{
    if(e.key==='Enter')document.getElementById('npbtn').click();});
}

/* restore session on load */
(async()=>{
  const hp=parseHash();
  if(hp.error||hp.error_code){
    history.replaceState(null,'',window.location.pathname);
    document.getElementById('login').style.display='flex';
    document.getElementById('lerr').textContent=
      decodeURIComponent((hp.error_description||hp.error||'').replace(/\+/g,' '))
      +' — request a new reset link.';
    return;
  }
  if(hp.access_token&&(hp.type==='recovery'||hp.type==='invite')){
    showRecover(hp); return;
  }
  const raw=localStorage.getItem(LS);
  if(raw){
    try{
      SESSION=JSON.parse(raw);
      if(await tok()){await boot();return;}
    }catch(e){}
  }
  document.getElementById('login').style.display='flex';
})();
