<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="robots" content="noindex,nofollow">
<meta name="theme-color" content="#020000" />
<title>Plaza &amp; Associates &mdash; CRM</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' fill='%23020000'/></svg>">
<style>
/* ===== Plazacore design tokens (identical :root) ===== */
:root{
  --black:#020000; --black-soft:#1a1818; --ink:#333333;
  --gray-50:#FAFAFA; --gray-100:#F4F4F4; --gray-200:#E5E5E5; --gray-300:#D4D4D4;
  --gray-400:#888888; --gray-500:#666666; --gray-700:#333333;
  --accent:#1f6581; --accent-bg:#e8eff2;
  --green:#1f6581; --green-bg:#e8eff2;
  --yellow:#666666; --yellow-bg:#F4F4F4;
  --red:#cf2e2e;    --red-bg:#fbe9e9;
  --blue:#1f6581;   --blue-bg:#e8eff2;
  --purple:#333333; --purple-bg:#F4F4F4;
  --navy:#020000;   --navy-soft:#1a1818; --navy-deep:#020000;
  --gold:#020000;   --gold-dark:#020000;
  --shadow-sm:0 1px 3px rgba(0,0,0,.05);
  --shadow-md:0 2px 8px rgba(0,0,0,.07);
  --shadow-lg:0 10px 30px rgba(0,0,0,.12);
  --radius:4px; --radius-sm:4px;
}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--gray-50);color:var(--ink);
  font:14px/1.5 -apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif}

/* ---------- login ---------- */
#login{position:fixed;inset:0;background:var(--gray-100);display:flex;align-items:center;justify-content:center;z-index:999}
.lbox{background:#FFFFFF;border:1px solid var(--gray-200);border-radius:var(--radius);padding:38px 34px;width:min(400px,92vw);box-shadow:var(--shadow-lg)}
.login-logo{width:180px;margin:0 auto 28px auto}
.login-logo svg{width:100%;height:auto;display:block}
.lbox .ls{color:var(--gray-400);font-size:11px;text-align:center;margin-bottom:24px;
  letter-spacing:2.5px;text-transform:uppercase}
.lbox input{width:100%;margin-bottom:11px}
.lbox button{width:100%}
#lerr{color:var(--red);font-size:12.5px;min-height:18px;margin-top:9px;text-align:center}

/* ---------- topbar (Plazacore pattern) ---------- */
header{background:#FFFFFF;color:var(--black);padding:18px 26px;
  display:flex;align-items:center;justify-content:space-between;gap:16px;
  position:sticky;top:0;z-index:50;border-bottom:1px solid var(--gray-200);
  padding-top:max(18px,env(safe-area-inset-top));flex-wrap:wrap}
.brand{display:flex;align-items:center;gap:14px}
.brand-logo{width:120px;height:auto;display:block}
.brand-logo svg{width:100%;height:auto;display:block}
.brand-divider{width:1px;height:28px;background:var(--gray-200)}
.brand-sub{font-size:11px;color:var(--gray-400);font-weight:400;letter-spacing:2.5px;
  text-transform:uppercase;line-height:1.2}
.brand-tag{font-size:10px;color:var(--accent);font-weight:600;letter-spacing:.8px;
  font-style:italic;line-height:1.1;white-space:nowrap}
.kpis{display:flex;gap:9px;margin-left:auto;flex-wrap:wrap;align-items:center}
.kpi{background:#FFFFFF;border:1px solid var(--gray-200);border-radius:var(--radius);padding:7px 12px;min-width:90px}
.kpi b{display:block;font-size:18px;color:var(--black);line-height:1.2;font-weight:600}
.kpi small{color:var(--gray-400);font-size:10px;text-transform:uppercase;letter-spacing:.6px}
.btn-logout{padding:6px 14px;font-size:12px;background:#FFFFFF;border:1px solid var(--gray-200);
  color:var(--gray-500);border-radius:var(--radius);cursor:pointer}
.btn-logout:hover{border-color:var(--accent);color:var(--accent)}

/* ---------- layout ---------- */
.wrap{display:grid;grid-template-columns:minmax(400px,1fr) minmax(460px,1.15fr);gap:15px;padding:20px 26px 40px}
@media(max-width:1150px){.wrap{grid-template-columns:1fr}}
.bar{display:flex;gap:7px;align-items:center;flex-wrap:wrap;margin-bottom:14px}
input,select,textarea,button{font:inherit;color:var(--ink);background:#FFFFFF;
  border:1px solid var(--gray-200);border-radius:var(--radius);padding:7px 10px}
input:focus,textarea:focus,select:focus{outline:none;border-color:var(--accent)}
textarea{width:100%;min-height:150px;resize:vertical;font-family:inherit}
button{cursor:pointer;transition:all .15s}
button:hover{border-color:var(--accent);color:var(--accent)}
button.pri{background:var(--black);color:#FFFFFF;border-color:var(--black);font-weight:600}
button.pri:hover{background:var(--black-soft);color:#FFFFFF;border-color:var(--black-soft)}
button.sm{padding:4px 9px;font-size:12px}

.grp{margin-bottom:22px}
.grp h3{font-size:11px;text-transform:uppercase;letter-spacing:1.1px;color:var(--gray-400);
  margin-bottom:8px;display:flex;gap:8px;align-items:center;font-weight:600}
.grp h3 i{flex:1;height:1px;background:var(--gray-200)}
.card{background:#FFFFFF;border:1px solid var(--gray-200);border-left:3px solid var(--gray-300);
  border-radius:var(--radius);padding:11px 13px;margin-bottom:7px;cursor:pointer;transition:.12s;
  box-shadow:var(--shadow-sm)}
.card:hover{border-color:var(--accent);box-shadow:var(--shadow-md)}
.card.sel{border-color:var(--accent);background:var(--accent-bg);border-left-color:var(--accent)}
.card.hot{border-left-color:var(--red)}
.card.warm{border-left-color:var(--yellow)}
.card.won{border-left-color:var(--accent)}
.card.cold{border-left-color:var(--gray-300)}
.ct{display:flex;justify-content:space-between;gap:9px;align-items:flex-start}
.cn{font-weight:600;font-size:13px;flex:1;color:var(--black)}
.pn{color:var(--accent);font-family:'SF Mono',Menlo,Consolas,monospace;font-size:11px}
.cm{color:var(--gray-500);font-size:11px;margin-top:5px;display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.pill{display:inline-block;padding:1.5px 7px;border-radius:20px;font-size:9.5px;font-weight:700;
  text-transform:uppercase;letter-spacing:.4px}
.p-HIGH{background:var(--red-bg);color:var(--red)}
.p-MEDIUM{background:var(--yellow-bg);color:var(--yellow)}
.p-LOW{background:var(--gray-100);color:var(--gray-500)}
.stg{background:var(--accent-bg);color:var(--accent)}
.age{color:var(--red);font-weight:600}
.age.ok{color:var(--gray-400);font-weight:400}

.panel{background:#FFFFFF;border:1px solid var(--gray-200);border-radius:var(--radius);padding:18px;
  position:sticky;top:90px;max-height:calc(100vh-110px);overflow-y:auto;box-shadow:var(--shadow-sm)}
.panel h2{font-size:16px;margin-bottom:3px;color:var(--black);font-weight:600}
.meta{color:var(--gray-400);font-size:11.5px;margin-bottom:13px}
.row{display:grid;grid-template-columns:108px 1fr;gap:8px;padding:7px 0;
  border-bottom:1px solid var(--gray-100);font-size:12.5px}
.row b{color:var(--gray-400);font-weight:500;font-size:11px;text-transform:uppercase;letter-spacing:.4px}
.ev{background:var(--gray-50);border:1px solid var(--gray-200);border-left:3px solid var(--accent);
  border-radius:var(--radius);padding:9px 11px;font-size:11.5px;color:var(--gray-700);margin:10px 0;line-height:1.55}
.na{background:var(--accent-bg);border:1px solid var(--gray-200);border-left:3px solid var(--black);
  border-radius:var(--radius);padding:9px 11px;font-size:12.5px;margin:10px 0;line-height:1.5}
.tabs{display:flex;gap:5px;margin:15px 0 10px;border-bottom:1px solid var(--gray-200)}
.tab{padding:8px 13px;border:1px solid transparent;border-bottom:none;border-radius:var(--radius) var(--radius) 0 0;
  color:var(--gray-500);cursor:pointer;font-size:12.5px}
.tab.on{background:#FFFFFF;border-color:var(--gray-200);color:var(--accent);font-weight:600}
.em{background:#FFFFFF;border:1px solid var(--gray-200);border-radius:var(--radius);
  padding:10px 12px;margin-bottom:6px;font-size:12px;cursor:pointer}
.em:hover{border-color:var(--accent)}
.em .eh{display:flex;justify-content:space-between;gap:9px;margin-bottom:3px}
.em .es{font-weight:600;flex:1;color:var(--black)}
.em .ed{color:var(--gray-400);font-size:10px;white-space:nowrap}
.em .ep{color:var(--gray-500);font-size:11px;max-height:34px;overflow:hidden}
.dir{font-size:9px;font-weight:800;padding:1px 5px;border-radius:var(--radius-sm);letter-spacing:.4px}
.dir.in{background:var(--accent-bg);color:var(--accent)}
.dir.out{background:var(--gray-100);color:var(--gray-500)}
.body{background:var(--gray-50);border:1px solid var(--gray-200);border-radius:var(--radius);
  padding:11px;margin-top:8px;font-size:11.5px;color:var(--gray-700);max-height:260px;
  overflow-y:auto;white-space:pre-wrap;line-height:1.6}
.act{border-left:2px solid var(--gray-200);padding:5px 0 5px 11px;margin-left:5px;font-size:12px}
.act .ak{font-size:9.5px;text-transform:uppercase;letter-spacing:.5px;color:var(--accent);font-weight:700}
.act .at{color:var(--gray-400);font-size:10px}
.note{color:var(--gray-700);font-size:12px;margin-top:2px}
.empty{color:var(--gray-400);text-align:center;padding:40px 20px;font-size:13px}
.ok{color:var(--accent)}.err{color:var(--red)}
.fl{display:flex;gap:7px;align-items:center;flex-wrap:wrap;margin-top:9px}
label.lb{font-size:10.5px;color:var(--gray-400);text-transform:uppercase;letter-spacing:.4px;
  display:block;margin-bottom:3px}
a{color:var(--accent)}
.warnbar{background:var(--red-bg);border:1px solid var(--red);color:var(--red);
  border-radius:var(--radius);padding:8px 11px;font-size:12px;margin:0 26px 4px}
</style>
</head>
<body>

<div id="login">
  <div class="lbox">
    <div class="login-logo" id="loginLogo"></div>
    <div class="ls">Deal CRM &middot; Authorized Access Only</div>
    <input id="lu" type="email" placeholder="Email" autocomplete="username">
    <input id="lp" type="password" placeholder="Password" autocomplete="current-password">
    <button class="pri" id="lbtn">Sign in</button>
    <div id="lerr"></div>
  </div>
</div>

<div id="recover" style="display:none">
  <div class="lbox">
    <div class="login-logo" id="recoverLogo"></div>
    <div class="ls">Set A New Password</div>
    <div id="rcvwho" style="color:var(--gray-500);font-size:12px;text-align:center;margin-bottom:14px"></div>
    <input id="np1" type="password" placeholder="New password (min 8 characters)" autocomplete="new-password">
    <input id="np2" type="password" placeholder="Confirm new password" autocomplete="new-password">
    <button class="pri" id="npbtn">Update password</button>
    <div id="nperr"></div>
  </div>
</div>

<div id="app" style="display:none">
<header>
  <div class="brand">
    <a href="#" id="brandLogo" class="brand-logo" aria-label="Plaza &amp; Associates" onclick="event.preventDefault();"></a>
    <div class="brand-divider"></div>
    <div class="brand-meta">
      <div class="brand-sub">Deal<br/>CRM</div>
      <div class="brand-tag">Engineering Florida&rsquo;s Future</div>
    </div>
  </div>
  <div class="kpis" id="kpis"></div>
  <button class="btn-logout" id="out">Sign out</button>
</header>
<div class="warnbar" id="wb" style="display:none"></div>
<div class="wrap">
  <div>
    <div class="bar">
      <input id="q" placeholder="Search deals, clients, contacts&hellip;" style="flex:1;min-width:170px">
      <select id="fs"><option value="">All stages</option></select>
      <select id="fp"><option value="">All priority</option><option>HIGH</option><option>MEDIUM</option><option>LOW</option></select>
      <button id="btnOverdue">Needs follow-up</button>
    </div>
    <div id="list"></div>
  </div>
  <div class="panel" id="panel"><div class="empty">Select a deal to view details, its live email thread, and reply inline.</div></div>
</div>
</div>

<script>
const SB_URL='https://zhxwkntrndaeqtkmbtsh.supabase.co';
const SB_KEY='sb_publishable_FU92Md7Bi2WojPfUqtKCGw_7pG7Ul6s';
const FN=SB_URL+'/functions/v1/graph-mail';
const LS='plaza_crm_session';
let SESSION=null, DEALS=[], CUR=null, TAB='emails', ONLY_OVERDUE=false;
const STAGES=["Lead","RFP Received","Proposal Sent","Negotiation","Won-Pending Payment","Won","On Hold","Stale","Lost"];
const OPEN=["Lead","RFP Received","Proposal Sent","Negotiation","Won-Pending Payment"];
const GROUPS=[
 {k:'hot', t:'Hot — action required now', s:["Negotiation","RFP Received"]},
 {k:'warm',t:'Proposals out — awaiting decision', s:["Proposal Sent","Lead"]},
 {k:'won', t:'Won / under contract', s:["Won","Won-Pending Payment"]},
 {k:'cold',t:'Stale / on hold / lost', s:["Stale","On Hold","Lost"]}];
const esc=s=>(s==null?'':String(s)).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const money=v=>v?'$'+Number(v).toLocaleString():'';
const days=s=>{if(!s)return null;const d=new Date(s+'T00:00:00');return Math.floor((new Date().setHours(0,0,0,0)-d)/864e5);};

/* ---------------- auth ---------------- */
async function signIn(email,password){
  const r=await fetch(SB_URL+'/auth/v1/token?grant_type=password',{method:'POST',
    headers:{'apikey':SB_KEY,'Content-Type':'application/json'},
    body:JSON.stringify({email,password})});
  const d=await r.json();
  if(!r.ok) throw new Error(d.error_description||d.msg||d.message||'Sign-in failed');
  return d;
}
async function refresh(){
  if(!SESSION?.refresh_token) return false;
  const r=await fetch(SB_URL+'/auth/v1/token?grant_type=refresh_token',{method:'POST',
    headers:{'apikey':SB_KEY,'Content-Type':'application/json'},
    body:JSON.stringify({refresh_token:SESSION.refresh_token})});
  if(!r.ok){logout();return false;}
  SESSION=await r.json();
  SESSION.expires_at=Date.now()+ (SESSION.expires_in||3600)*1000;
  localStorage.setItem(LS,JSON.stringify(SESSION));
  return true;
}
async function tok(){
  if(SESSION&&SESSION.expires_at&&Date.now()>SESSION.expires_at-90000) await refresh();
  return SESSION?.access_token;
}
function logout(){SESSION=null;localStorage.removeItem(LS);
  document.getElementById('app').style.display='none';
  document.getElementById('login').style.display='flex';}
document.getElementById('lbtn').onclick=async()=>{
  const e=document.getElementById('lu').value.trim(), p=document.getElementById('lp').value;
  const box=document.getElementById('lerr'); box.textContent='Signing in...';
  try{
    SESSION=await signIn(e,p);
    SESSION.expires_at=Date.now()+(SESSION.expires_in||3600)*1000;
    localStorage.setItem(LS,JSON.stringify(SESSION));
    box.textContent=''; boot();
  }catch(err){box.textContent=err.message;}
};
document.getElementById('lp').addEventListener('keydown',e=>{if(e.key==='Enter')document.getElementById('lbtn').click();});
document.getElementById('out').onclick=logout;

/* ---------------- data ---------------- */
async function api(path,opts={}){
  const t=await tok();
  const r=await fetch(SB_URL+'/rest/v1/'+path,{...opts,
    headers:{'apikey':SB_KEY,'Authorization':'Bearer '+t,'Content-Type':'application/json',
      'Prefer':opts.method==='PATCH'?'return=representation':'', ...(opts.headers||{})}});
  if(r.status===401){await refresh();throw new Error('session expired — retry');}
  if(!r.ok) throw new Error((await r.text()).slice(0,200));
  return r.status===204?null:r.json();
}
async function fn(payload){
  const t=await tok();
  const r=await fetch(FN,{method:'POST',
    headers:{'apikey':SB_KEY,'Authorization':'Bearer '+t,'Content-Type':'application/json'},
    body:JSON.stringify(payload)});
  const d=await r.json();
  if(!r.ok) throw new Error(d.error||('HTTP '+r.status));
  return d;
}
async function boot(){
  document.getElementById('login').style.display='none';
  document.getElementById('app').style.display='block';
  const sf=document.getElementById('fs');
  if(sf.options.length===1) STAGES.forEach(s=>sf.add(new Option(s,s)));
  await load();
}
async function load(){
  DEALS=await api('deals?select=*&order=project_no.asc.nullslast');
  DEALS.forEach(d=>{
    d.days_since_contact=days(d.last_contact_date);
    d.days_since_proposal=days(d.proposal_sent_date);
    d.is_open=OPEN.includes(d.stage);
    d.overdue=d.is_open&&(d.days_since_contact||0)>=14;
  });
  kpis(); render();
}
function kpis(){
  const open=DEALS.filter(d=>d.is_open), won=DEALS.filter(d=>d.stage.startsWith('Won'));
  const od=open.filter(d=>d.overdue);
  const ar=DEALS.filter(d=>d.stage==='Won-Pending Payment').reduce((a,b)=>a+(+b.amount||0),0);
  document.getElementById('kpis').innerHTML=`
   <div class="kpi"><b>${open.length}</b><small>Open deals</small></div>
   <div class="kpi"><b>${won.length}</b><small>Won 2026</small></div>
   <div class="kpi"><b style="color:#ff7b72">${od.length}</b><small>Need follow-up</small></div>
   <div class="kpi"><b>${money(ar)||'$0'}</b><small>A/R pending</small></div>`;
}
function render(){
  const q=document.getElementById('q').value.toLowerCase();
  const fs=document.getElementById('fs').value, fp=document.getElementById('fp').value;
  const rows=DEALS.filter(d=>{
    const hay=[d.name,d.client,d.contact_name,d.contact_email,d.project_no,d.next_action].join(' ').toLowerCase();
    if(q&&!hay.includes(q))return false;
    if(fs&&d.stage!==fs)return false;
    if(fp&&d.priority!==fp)return false;
    if(ONLY_OVERDUE&&!d.overdue)return false;
    return true;});
  const box=document.getElementById('list');
  if(!rows.length){box.innerHTML='<div class="empty">No deals match.</div>';return;}
  const pr={HIGH:0,MEDIUM:1,LOW:2};let h='';
  for(const g of GROUPS){
    const sub=rows.filter(d=>g.s.includes(d.stage));
    if(!sub.length)continue;
    sub.sort((a,b)=>(pr[a.priority]-pr[b.priority])||((b.days_since_contact||0)-(a.days_since_contact||0)));
    h+=`<div class="grp"><h3>${g.t} &middot; ${sub.length}<i></i></h3>`;
    for(const d of sub){
      h+=`<div class="card ${g.k} ${CUR&&CUR.id===d.id?'sel':''}" onclick="open_(${d.id})">
        <div class="ct"><div class="cn">${esc(d.name)}</div>${d.project_no?`<div class="pn">${esc(d.project_no)}</div>`:''}</div>
        <div class="cm"><span class="pill p-${d.priority}">${d.priority}</span>
          <span class="pill stg">${esc(d.stage)}</span>
          ${d.value_note?`<span>${esc(d.value_note)}</span>`:''}
          ${d.days_since_contact!=null?`<span class="age ${d.overdue?'':'ok'}">${d.days_since_contact}d since contact</span>`:''}
        </div></div>`;
    }
    h+='</div>';
  }
  box.innerHTML=h;
}
function open_(id){CUR=DEALS.find(d=>d.id===id);TAB='emails';render();draw();}
function draw(){
  const d=CUR;if(!d)return;
  document.getElementById('panel').innerHTML=`
  <h2>${esc(d.name)}</h2>
  <div class="meta">${d.project_no?'Project '+esc(d.project_no)+' &middot; ':''}${esc(d.client||'')}</div>
  <div class="row"><b>Stage</b><div><select id="edStage">${STAGES.map(s=>`<option${s===d.stage?' selected':''}>${s}</option>`).join('')}</select>
    <select id="edPri">${['HIGH','MEDIUM','LOW'].map(s=>`<option${s===d.priority?' selected':''}>${s}</option>`).join('')}</select>
    <button class="sm" onclick="saveStage()">Save</button> <span id="sst"></span></div></div>
  <div class="row"><b>Contact</b><div>${esc(d.contact_name||'—')}${d.contact_email?`<br><a href="mailto:${esc(d.contact_email)}">${esc(d.contact_email)}</a>`:''}</div></div>
  <div class="row"><b>Value</b><div>${esc(d.value_note||'TBD')}</div></div>
  <div class="row"><b>Proposal sent</b><div>${esc(d.proposal_sent_date||'—')}${d.days_since_proposal!=null?` <span class="at">(${d.days_since_proposal}d ago)</span>`:''}</div></div>
  <div class="row"><b>Last contact</b><div>${esc(d.last_contact_date||'—')}${d.days_since_contact!=null?` <span class="${d.overdue?'err':'at'}">(${d.days_since_contact}d ago)</span>`:''}</div></div>
  ${d.next_action?`<div class="na"><b>NEXT:</b> ${esc(d.next_action)}${d.next_action_due?` <b>(due ${esc(d.next_action_due)})</b>`:''}</div>`:''}
  ${d.evidence?`<div class="ev"><b>EVIDENCE:</b> ${esc(d.evidence)}</div>`:''}
  ${d.dropbox_folder?`<div class="row"><b>Dropbox</b><div style="font-size:11px;color:var(--dim)">${esc(d.dropbox_folder)}</div></div>`:''}
  <div class="tabs">
    <div class="tab ${TAB==='emails'?'on':''}" onclick="setTab('emails')">Email thread</div>
    <div class="tab ${TAB==='compose'?'on':''}" onclick="setTab('compose')">Compose follow-up</div>
    <div class="tab ${TAB==='acts'?'on':''}" onclick="setTab('acts')">Activity log</div>
  </div><div id="tabbody"><div class="empty">Loading...</div></div>`;
  if(TAB==='emails')loadEmails();
  if(TAB==='compose')loadCompose();
  if(TAB==='acts')loadActs();
}
function setTab(t){TAB=t;draw();}
async function saveStage(){
  const stage=document.getElementById('edStage').value, priority=document.getElementById('edPri').value;
  const st=document.getElementById('sst');st.textContent='Saving...';
  try{
    if(stage!==CUR.stage) await api('activities',{method:'POST',
      body:JSON.stringify({deal_id:CUR.id,kind:'stage_change',summary:`${CUR.stage} -> ${stage}`})});
    await api('deals?id=eq.'+CUR.id,{method:'PATCH',body:JSON.stringify({stage,priority})});
    await load(); CUR=DEALS.find(x=>x.id===CUR.id); draw();
  }catch(e){st.innerHTML='<span class="err">'+esc(e.message)+'</span>';}
}
async function loadEmails(){
  const b=document.getElementById('tabbody');
  b.innerHTML='<div class="empty">Searching mailbox via Microsoft Graph...</div>';
  const kws=(CUR.keywords&&CUR.keywords.length)?CUR.keywords:(CUR.contact_email?[CUR.contact_email]:[]);
  if(!kws.length){b.innerHTML='<div class="empty">No search keywords for this deal.</div>';return;}
  try{
    const ms=await fn({action:'search',keywords:kws});
    if(!ms.length){b.innerHTML='<div class="empty">No matching emails found.</div>';return;}
    b.innerHTML=ms.map(m=>`<div class="em" onclick="expand(this,'${m.id}')">
      <div class="eh"><div class="es">${esc(m.subject)}</div>
      <div class="ed"><span class="dir ${m.direction}">${m.direction.toUpperCase()}</span> ${esc((m.date||'').replace('T',' ').slice(0,16))}</div></div>
      <div class="ep">${m.direction==='in'?'From: '+esc(m.from):'To: '+esc((m.to||[]).join(', '))} — ${esc((m.preview||'').slice(0,150))}</div>
      <div class="slot"></div></div>`).join('');
  }catch(e){b.innerHTML='<div class="empty err">Email error: '+esc(e.message)+'</div>';}
}
async function expand(el,mid){
  const slot=el.querySelector('.slot');
  if(slot.dataset.open){slot.innerHTML='';delete slot.dataset.open;return;}
  slot.dataset.open='1';slot.innerHTML='<div class="body">Loading full message...</div>';
  try{
    const m=await fn({action:'message',id:mid});
    slot.innerHTML=`<div class="body">${esc(m.body||'')}</div>
     <div style="margin-top:8px"><label class="lb">Reply in this thread (reply-all, signature auto-added)</label>
     <textarea id="rb_${mid}" placeholder="Type your reply..."></textarea>
     <div class="fl"><button class="pri" onclick="event.stopPropagation();doReply('${mid}')">Send reply</button>
     <span id="rs_${mid}"></span></div></div>`;
  }catch(e){slot.innerHTML='<div class="body err">'+esc(e.message)+'</div>';}
}
async function doReply(mid){
  const body=document.getElementById('rb_'+mid).value.trim();
  const st=document.getElementById('rs_'+mid);
  if(!body){st.innerHTML='<span class="err">Empty</span>';return;}
  if(!confirm('Send this reply from william@plazaandassociates.com?'))return;
  st.textContent='Sending...';
  try{
    await fn({action:'reply',id:mid,body});
    st.innerHTML='<span class="ok">Sent &check;</span>';
    await api('activities',{method:'POST',body:JSON.stringify({deal_id:CUR.id,kind:'email_sent',summary:'Replied in thread: '+body.slice(0,120),body})});
    await api('deals?id=eq.'+CUR.id,{method:'PATCH',body:JSON.stringify({last_contact_date:new Date().toISOString().slice(0,10)})});
    await load();CUR=DEALS.find(x=>x.id===CUR.id);
  }catch(e){st.innerHTML='<span class="err">'+esc(e.message)+'</span>';}
}
function loadCompose(){
  const d=CUR;
  const nm=(d.contact_name||'there').split(',')[0].split(' ')[0];
  const subject='Following Up — '+d.name;
  const body=`Hello ${nm},\n\nI hope you're doing well. I wanted to follow up on our proposal submitted on ${d.proposal_sent_date||'recently'} for ${d.name}.\n\nPlease let me know if the Board has had a chance to review, or if you need any clarification or additional information from our end. We're ready to move forward as soon as you are.\n\nThank you for the opportunity.`;
  document.getElementById('tabbody').innerHTML=`
   <label class="lb">To</label><input id="cto" style="width:100%" value="${esc(d.contact_email||'')}">
   <label class="lb" style="margin-top:8px">CC</label><input id="ccc" style="width:100%" placeholder="optional">
   <label class="lb" style="margin-top:8px">Subject</label><input id="csub" style="width:100%" value="${esc(subject)}">
   <label class="lb" style="margin-top:8px">Body (signature auto-added)</label>
   <textarea id="cbody" style="min-height:190px">${esc(body)}</textarea>
   <div class="fl"><button class="pri" onclick="doCompose()">Send email</button><span id="cst"></span></div>`;
}
async function doCompose(){
  const to=document.getElementById('cto').value.split(',').map(s=>s.trim()).filter(Boolean);
  const cc=document.getElementById('ccc').value.split(',').map(s=>s.trim()).filter(Boolean);
  const subject=document.getElementById('csub').value, body=document.getElementById('cbody').value;
  const st=document.getElementById('cst');
  if(!to.length||!subject||!body){st.innerHTML='<span class="err">to, subject, body required</span>';return;}
  if(!confirm('Send to '+to.join(', ')+' from william@plazaandassociates.com?'))return;
  st.textContent='Sending...';
  try{
    await fn({action:'send',to,cc,subject,body});
    st.innerHTML='<span class="ok">Sent &check;</span>';
    await api('activities',{method:'POST',body:JSON.stringify({deal_id:CUR.id,kind:'email_sent',summary:`Sent '${subject}' to ${to.join(', ')}`,body})});
    await api('deals?id=eq.'+CUR.id,{method:'PATCH',body:JSON.stringify({last_contact_date:new Date().toISOString().slice(0,10)})});
    await load();CUR=DEALS.find(x=>x.id===CUR.id);
  }catch(e){st.innerHTML='<span class="err">'+esc(e.message)+'</span>';}
}
async function loadActs(){
  const b=document.getElementById('tabbody');
  const as=await api(`activities?deal_id=eq.${CUR.id}&select=*&order=occurred_at.desc&limit=60`);
  b.innerHTML=`<div style="margin-bottom:12px"><label class="lb">Add note</label>
    <textarea id="nb" style="min-height:70px"></textarea>
    <div class="fl"><button onclick="addNote()">Save note</button><span id="nst"></span></div></div>`
   +(as.length?as.map(a=>`<div class="act"><div class="ak">${esc(a.kind)}</div>
     <div class="at">${esc((a.occurred_at||'').replace('T',' ').slice(0,16))}</div>
     <div class="note">${esc(a.summary)}</div></div>`).join(''):'<div class="empty">No activity yet.</div>');
}
async function addNote(){
  const note=document.getElementById('nb').value.trim();if(!note)return;
  await api('activities',{method:'POST',body:JSON.stringify({deal_id:CUR.id,kind:'note',summary:note})});
  loadActs();
}
